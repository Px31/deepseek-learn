# DeepSeek Learn configuration.
# Copy to .env and adjust. Every value has a sensible default.

# Where Ollama runs. On 32-bit machines (no native Ollama build) point this
# at a 64-bit sidecar, e.g. OLLAMA_HOST=http://192.168.1.50:11434
OLLAMA_HOST=http://localhost:11434

BACKEND_PORT=8888
FRONTEND_PORT=3000

# Idle shutdown: if the web app stops heartbeating (tab closed, browser
# crashed) for this many seconds, the backend unloads the Ollama models and
# exits, freeing RAM. 0 = never auto-shutdown. Default when unset: 120.
IDLE_SHUTDOWN_SECONDS=120
